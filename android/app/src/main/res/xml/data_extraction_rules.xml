<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Offline-Daten (WebView-localStorage mit Bartclicker-Spielstand,
     Caches, Login) werden ins Google-Backup und beim Gerätewechsel mitgenommen. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="root" path="app_webview/Default/Cache" />
        <exclude domain="root" path="app_webview/Default/Code Cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
