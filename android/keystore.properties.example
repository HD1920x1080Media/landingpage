# Kopieren nach android/keystore.properties und ausfüllen (Datei ist in .gitignore).
# Keystore erzeugen (einmalig, gut aufbewahren — ohne ihn keine Updates im Play Store!):
#   keytool -genkeypair -v -keystore release.jks -alias hd1920x1080 -keyalg RSA -keysize 4096 -validity 10000
storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=hd1920x1080
keyPassword=CHANGE_ME
